# Groq hosts the model. No OpenAI or Amadeus credentials are used.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SERPAPI_API_KEY=
GEOAPIFY_API_KEY=

# Conservative local caps. Failed attempts count. Cached requests cost nothing.
# SerpApi limits are rolling windows; at least 20 provider-plan searches stay reserved.
SERPAPI_31_DAY_LIMIT=200
SERPAPI_DAILY_LIMIT=10
GEOAPIFY_DAILY_LIMIT=500
GROQ_DAILY_CALL_LIMIT=100

# Optional location of the private SQLite cache/usage database.
# ROAM_DB_PATH=.local/state.sqlite3
